self:
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.services.wittypi;
  home = "/var/lib/wittypi";
  # Upstream's I2C_BUS; the device unit for /dev/i2c-1.
  i2cDevice = "dev-i2c\\x2d1.device";

  hookScript =
    name: text:
    pkgs.writeShellScript name ''
      # Generated by services.wittypi.
      ${text}
    '';

  hooks = {
    "beforeScript.sh" = cfg.beforeScript;
    "afterStartup.sh" = cfg.afterStartup;
    "beforeShutdown.sh" = cfg.beforeShutdown;
  };
in
{
  options.services.wittypi = {
    enable = lib.mkEnableOption "the UUGear Witty Pi 4 daemon";

    package = lib.mkOption {
      type = lib.types.package;
      default = self.packages.${pkgs.stdenv.hostPlatform.system}.wittypi4;
      defaultText = lib.literalExpression "witty-pi-4-nix.packages.\${system}.wittypi4";
      description = "The Witty Pi 4 software package to use.";
    };

    schedule = lib.mkOption {
      type = lib.types.nullOr lib.types.lines;
      default = null;
      example = ''
        BEGIN 2015-08-01 00:00:00
        END   2025-07-31 23:59:59
        ON    M5
        OFF   M15
      '';
      description = ''
        Contents of the schedule script (`schedule.wpi`). When `null`, the
        schedule is left mutable and can be chosen with the `wittypi` tool.
        When set, choosing a schedule with the `wittypi` tool will fail.
      '';
    };

    beforeScript = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = ''
        Commands run after boot, before the schedule script is applied
        (`beforeScript.sh`). Runs as root and blocks the daemon; append `&`
        to long-running commands.
      '';
    };

    afterStartup = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = ''
        Commands run after boot, once the schedule script has been applied
        (`afterStartup.sh`). Runs as root and blocks the daemon; append `&`
        to long-running commands.
      '';
    };

    beforeShutdown = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = ''
        Commands run when Witty Pi requests a shutdown, before the system is
        halted (`beforeShutdown.sh`). Runs as root; shutdown waits for it.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    hardware.i2c.enable = lib.mkDefault true;

    # /dev/i2c-1 appears once the I2C controller driver has probed, which can
    # be after systemd-modules-load. Tag it so the service can wait for it.
    services.udev.extraRules = ''
      SUBSYSTEM=="i2c-dev", KERNEL=="i2c-1", TAG+="systemd"
    '';

    environment.systemPackages = [ cfg.package ];

    systemd.tmpfiles.settings.wittypi = {
      ${home}.d = {
        mode = "0755";
        user = "root";
        group = "root";
      };
    }
    // lib.mapAttrs' (
      name: text: lib.nameValuePair "${home}/${name}" { "L+".argument = "${hookScript name text}"; }
    ) hooks
    // lib.optionalAttrs (cfg.schedule != null) {
      "${home}/schedule.wpi"."L+".argument = "${pkgs.writeText "schedule.wpi" cfg.schedule}";
    };

    systemd.services.wittypi = {
      description = "Witty Pi 4 daemon";
      wantedBy = [ "multi-user.target" ];
      # Wants rather than requires: if the bus never appears, the daemon still
      # starts after the device timeout and logs that the board is missing.
      wants = [ i2cDevice ];
      after = [
        i2cDevice
        "systemd-modules-load.service"
        "systemd-tmpfiles-setup.service"
      ];
      # The daemon performs one-off startup work (time sync, scheduling,
      # SYS_UP signal) and then waits for the shutdown request; restarting it
      # on every switch would repeat that.
      restartIfChanged = false;

      environment.WITTYPI_HOME = home;

      preStart = lib.optionalString (cfg.schedule == null) ''
        # Drop a schedule left behind by a previous declarative configuration.
        if [ -L ${home}/schedule.wpi ] \
          && [[ "$(readlink ${home}/schedule.wpi)" == ${builtins.storeDir}/* ]]; then
          rm ${home}/schedule.wpi
        fi
      '';

      serviceConfig = {
        Type = "simple";
        ExecStart = lib.getExe' cfg.package "wittypi-daemon";
        Restart = "no";
        # Everything on stdout is also sent to syslog by the scripts.
        StandardOutput = "null";
        StandardError = "journal";
        SyslogIdentifier = "wittypi";
      };
    };
  };
}
